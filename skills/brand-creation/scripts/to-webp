#!/usr/bin/env python3
"""Convert PNG masters to WebP for shipping.

Usage: to-webp --quality 82 <in.png>... --out-dir <dir>

Keeps the PNG as the master; writes <name>.webp beside or into --out-dir and
prints the size saved. Lossless is used for images with transparency so edges
stay clean; everything else is lossy at the given quality.
"""
from __future__ import annotations

import argparse
import pathlib
import sys

from PIL import Image


def convert(src: pathlib.Path, out_dir: pathlib.Path | None, quality: int) -> pathlib.Path:
    image = Image.open(src)
    target = (out_dir or src.parent) / (src.stem + ".webp")
    target.parent.mkdir(parents=True, exist_ok=True)
    has_alpha = image.mode in ("RGBA", "LA") or (image.mode == "P" and "transparency" in image.info)
    if has_alpha:
        image.convert("RGBA").save(target, "WEBP", lossless=True, method=6)
    else:
        image.convert("RGB").save(target, "WEBP", quality=quality, method=6)
    return target


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("inputs", nargs="+", type=pathlib.Path)
    parser.add_argument("--out-dir", type=pathlib.Path)
    parser.add_argument("--quality", type=int, default=82)
    args = parser.parse_args()
    for src in args.inputs:
        target = convert(src, args.out_dir, args.quality)
        before, after = src.stat().st_size, target.stat().st_size
        print(f"{src.name} -> {target}  {before // 1024} KB -> {after // 1024} KB ({100 - after * 100 // max(before, 1)}% smaller)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
